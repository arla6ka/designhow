export function Save({ saving, isPending, loading, save }) {
  return (
    <form>
      <button type="submit" disabled={saving}>{saving ? "Saving…" : "Save"}</button>
      <Button disabled={isPending}>
        {isPending ? <Spinner /> : "Send invite"}
      </Button>
      <Button onClick={save}>{loading ? "Please wait" : "Continue"}</Button>
    </form>
  );
}
