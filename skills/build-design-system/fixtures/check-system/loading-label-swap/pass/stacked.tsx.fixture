export function Publish({ publishing }) {
  return (
    <Button type="submit" aria-busy={publishing} aria-disabled={publishing}>
      <span className="grid">
        <span className={publishing ? "invisible col-start-1 row-start-1" : "col-start-1 row-start-1"}>Publish</span>
        <span aria-hidden={!publishing} className={publishing ? "col-start-1 row-start-1" : "invisible col-start-1 row-start-1"}>Publishing</span>
      </span>
    </Button>
  );
}
