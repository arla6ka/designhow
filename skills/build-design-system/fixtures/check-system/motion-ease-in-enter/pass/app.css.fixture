@keyframes fade-in { from { opacity: 0 } to { opacity: 1 } }
@keyframes fade-out { from { opacity: 1 } to { opacity: 0 } }
@keyframes spin { to { transform: rotate(1turn) } }
.toast { animation: fade-in 200ms ease-out; }
.toast[data-state="closed"] { animation: fade-out 150ms ease-in; }
.panel[data-state="open"] { transition: opacity 150ms ease-out; }
.panel { transition: opacity 100ms ease-in; }
.spinner { animation: spin 1s linear infinite; }
