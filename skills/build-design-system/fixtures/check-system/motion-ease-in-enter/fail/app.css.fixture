@keyframes fade-in { from { opacity: 0 } to { opacity: 1 } }
@keyframes rise { from { opacity: 0; transform: translateY(4px) } to { opacity: 1; transform: none } }
.toast { animation: fade-in 200ms ease-in; }
.menu { animation-name: rise; animation-timing-function: cubic-bezier(0.4, 0, 1, 1); }
.panel[data-state="open"] { transition: opacity 150ms ease-in; }
