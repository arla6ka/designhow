export function List({ open, track, onKey, close, dialogRef }) {
  return (
    <div onKeyDown={onKey}>
      <Button type="button" onClick={open}>Row</Button>
      <a href="/projects" onClick={track}>Projects</a>
      <div role="tab" tabIndex={0} aria-selected="true" onClick={open}>Tab</div>
      <li role="option" aria-selected="false" onMouseDown={open}>Option</li>
      <div tabIndex={-1} onKeyDown={onKey}>Scroll region</div>
      <Card onClick={open} />
      <dialog
        ref={dialogRef}
        onClick={(e) => e.target === dialogRef.current && close()}
        onCancel={close}
      >
        Backdrop click closes, Escape fires cancel
      </dialog>
    </div>
  );
}
