export function Team({ inviteOpen, setInviteOpen, error }) {
  return (
    <section>
      <Dialog open={inviteOpen} onOpenChange={setInviteOpen}>
        <DialogContent>
          {error && <DialogDescription>{error}</DialogDescription>}
        </DialogContent>
      </Dialog>
      {/* {open && <Dialog>} in a comment is not code */}
      <p>{"a && <Dialog> inside a string"}</p>
    </section>
  );
}
