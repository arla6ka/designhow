export function Team({ inviteOpen, setInviteOpen, confirm, menu }) {
  return (
    <section>
      {inviteOpen && (
        <Dialog open onOpenChange={(open) => !open && setInviteOpen(false)}>
          <DialogContent>Invite</DialogContent>
        </Dialog>
      )}
      {confirm && <AlertDialog open>Delete?</AlertDialog>}
      {menu ? <Popover open>Menu</Popover> : null}
    </section>
  );
}
