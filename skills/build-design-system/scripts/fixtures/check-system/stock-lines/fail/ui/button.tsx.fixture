import { cva } from "class-variance-authority";
const buttonVariants = cva(
  "inline-flex shrink-0 items-center justify-center rounded-[min(var(--radius-md),10px)] text-sm font-medium",
  {
    variants: {
      size: {
        default: "h-9 px-4",
        xs: "h-6 gap-1 px-2 text-[0.8rem]",
        lg: "h-10 px-[13px]",
      },
    },
  }
);
export function Button({ size, className, ...props }) {
  return <button className={buttonVariants({ size, className })} {...props} />;
}
