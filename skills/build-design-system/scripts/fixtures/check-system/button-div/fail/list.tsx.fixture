export function List({ open, items }) {
  return (
    <ul>
      <div
        className="row"
        onClick={() => open()}
      >
        Row
      </div>
      <span onClick={open}>More</span>
      <a onClick={open}>Details</a>
      {items.map((i) => <li key={i} onClick={() => open(i)}>{i}</li>)}
      <li onPointerDown={open}>Pressed row</li>
      <span onMouseDown={open}>Mouse only</span>
      <div
        tabIndex={0}
        onKeyDown={(e) => e.key === "Enter" && open()}
      >
        Keyboard row
      </div>
      <dialog open onClick={open}>No keyboard path</dialog>
    </ul>
  );
}
