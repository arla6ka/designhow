import { Button } from "@/components/ui/button";
import { AlertDialog, AlertDialogTitle, AlertDialogAction } from "@/components/ui/alert-dialog";
import { toast } from "sonner";

export function DeleteProject({ project }: { project: { name: string } }) {
  const onDelete = () => {
    toast.success(`Deleted ${project.name}.`);
  };
  return (
    <div>
      <input placeholder="Search projects" />
      <Button variant="destructive">Delete this project and its files</Button>
      <AlertDialog>
        <AlertDialogTitle>Delete {project.name}?</AlertDialogTitle>
        <AlertDialogAction onClick={onDelete}>Delete</AlertDialogAction>
      </AlertDialog>
    </div>
  );
}
